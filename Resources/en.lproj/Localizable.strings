/* MARK: - Move to /Applications */

"alert.move.title" = "Move to Applications";
"alert.move.body" = "MenuBarKeeper must run from the Applications folder. Otherwise, once icons are hidden, macOS hides its own menu bar icon too and you lose the only way to control it.\n\nThe app will be copied to /Applications and restarted. Code signing and permission records are independent of the path, so you will not have to grant access again.";
